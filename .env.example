# ─── LLM (Groq) ──────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# Model selection — must be a Groq-hosted model that supports JSON mode
# Recommended: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
MODEL_NAME=llama-3.3-70b-versatile

# ─── Web Search ──────────────────────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=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.

# ─── Optional: persist ChromaDB to a custom path ─────
CHROMA_PERSIST_DIR=./data/chroma_db

# ─── Embeddings ──────────────────────────────────────
# HuggingFace model used for local embeddings (no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
